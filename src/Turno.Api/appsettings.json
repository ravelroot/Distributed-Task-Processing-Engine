{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Warning",
      "RedLockNet": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Turno": ""
  },
  "Turno": {
    "Api": {
      "ApiKey": "",
      "AllowedOrigins": [],
      "EnableApiReference": true
    },
    "Database": {
      "ApplyMigrations": true
    },
    "Messaging": {
      "Transport": "RabbitMq",
      "QueuePrefix": "turno",
      "RabbitMq": {
        "Host": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "Username": "",
        "Password": ""
      },
      "AzureServiceBus": {
        "ConnectionString": ""
      }
    },
    "Redis": {
      "Connections": [ "localhost:6379" ],
      "KeyPrefix": "turno"
    },
    "Resilience": {
      "DefaultMaxAttempts": 5,
      "Types": {
        "integration.sync": { "MaxAttempts": 6 }
      }
    }
  }
}
