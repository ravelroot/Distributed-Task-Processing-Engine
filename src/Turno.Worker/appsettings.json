{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Warning",
      "RedLockNet": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "ConnectionStrings": {
    "Turno": ""
  },
  "Turno": {
    "Database": {
      "ApplyMigrations": true
    },
    "Messaging": {
      "Transport": "RabbitMq",
      "QueuePrefix": "turno",
      "RabbitMq": {
        "Host": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "Username": "",
        "Password": ""
      },
      "AzureServiceBus": {
        "ConnectionString": ""
      }
    },
    "Redis": {
      "Connections": [ "localhost:6379" ],
      "KeyPrefix": "turno"
    },
    "Worker": {
      "Name": "",
      "Queues": [
        { "Name": "default", "Concurrency": 4 },
        { "Name": "critical", "Concurrency": 2 },
        { "Name": "reports", "Concurrency": 2 }
      ],
      "LeaseDuration": "00:01:00",
      "LeaseRenewalInterval": "00:00:10",
      "LockExpiry": "00:00:30",
      "HeartbeatInterval": "00:00:05",
      "ConcurrencyKeyRetryDelay": "00:00:05",
      "ProgressThrottle": "00:00:01",
      "ShutdownTimeout": "00:00:30"
    },
    "Scheduler": {
      "Enabled": true,
      "Interval": "00:00:02",
      "BatchSize": 200
    },
    "Recovery": {
      "Enabled": true,
      "Interval": "00:00:10",
      "LeaseGracePeriod": "00:00:15",
      "RedispatchEnqueuedAfter": "00:00:00",
      "BatchSize": 100
    },
    "Retention": {
      "Enabled": true,
      "Interval": "00:10:00",
      "SucceededJobs": "7.00:00:00",
      "CancelledJobs": "7.00:00:00",
      "FailedJobs": "30.00:00:00",
      "OfflineWorkers": "1.00:00:00",
      "StaleWorkerAfter": "00:00:30"
    },
    "Resilience": {
      "ImmediateRetries": 2,
      "ImmediateRetryDelay": "00:00:00.500",
      "DefaultMaxAttempts": 5,
      "BackoffBase": "00:00:15",
      "BackoffMax": "00:15:00",
      "BackoffJitter": 0.2,
      "DefaultTimeout": "00:10:00",
      "CircuitBreaker": {
        "Enabled": true,
        "FailureRatio": 0.5,
        "SamplingDuration": "00:00:30",
        "MinimumThroughput": 10,
        "BreakDuration": "00:00:30"
      },
      "Types": {
        "report.generate": { "Timeout": "00:30:00" },
        "integration.sync": { "ImmediateRetries": 3, "MaxAttempts": 6 }
      }
    },
    "Samples": {
      "Enabled": true
    },
    "RecurringJobs": [
      {
        "Name": "relatorio-diario",
        "Type": "report.generate",
        "Queue": "reports",
        "Cron": "0 6 * * *",
        "TimeZone": "America/Sao_Paulo",
        "Payload": { "rows": 250000, "segments": 12 },
        "Enabled": true
      },
      {
        "Name": "sincronia-parceiros",
        "Type": "integration.sync",
        "Cron": "*/15 * * * *",
        "TimeZone": "America/Sao_Paulo",
        "Payload": { "records": 120, "failureRate": 0.2, "latencyMs": 300 },
        "Enabled": false
      }
    ]
  }
}
