<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1724;CA1031;CA2007;CA1062;CA1303;CA1515;CA1819;CA2227;CA1002;CA1056;CA1054;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1812;CA1852;CA5394;CA1873</NoWarn>
    <Version>1.0.0</Version>
    <Product>Turno</Product>
    <Authors>Erik L. Pimenta</Authors>
    <Copyright>Copyright (c) 2026 Turno</Copyright>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
